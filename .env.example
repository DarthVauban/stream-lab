# Локальний API медіасервера
MEDIA_API_HOST=127.0.0.1
MEDIA_API_PORT=8788
MEDIA_DATA_DIR=./data
MEDIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Доступ OWNER і шифрування стану стріму. Згенеруйте три секрети командою npm run auth:setup.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=''
SESSION_SECRET=''
STREAM_CONFIG_SECRET=''
AUTH_SESSION_TTL_SECONDS=43200
# Для production через Caddy залишайте true. Для локального HTTP використовуйте false.
AUTH_COOKIE_SECURE=true

# Публічна адреса production-панелі. Caddy автоматично отримує та поновлює HTTPS-сертифікат.
STREAMLAB_DOMAIN=stream.mt-panel.sbs

# OAuth 2.0 для підключення YouTube-каналу. Redirect URI має точно збігатися з Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''
GOOGLE_OAUTH_REDIRECT_URI='https://stream.mt-panel.sbs/api/youtube/oauth/callback'
# Необов'язково: окремий секрет для OAuth-токенів. Якщо порожній, використовується STREAM_CONFIG_SECRET.
YOUTUBE_TOKEN_SECRET=''
YOUTUBE_DAILY_QUOTA=10000

# Telegram: публічний HTTPS webhook та whitelist числових ID через кому.
# Секрет webhook StreamLab створює автоматично й зберігає зашифрованим.
TELEGRAM_WEBHOOK_URL='https://stream.mt-panel.sbs/api/telegram/webhook'
TELEGRAM_ALLOWED_USER_IDS=''
TELEGRAM_ALLOWED_CHAT_IDS=''

# PostgreSQL зберігає стан застосунку та журнал дій. Згенеруйте окремий довгий пароль для production.
POSTGRES_PASSWORD=''
# Для локального запуску без Docker ці адреси необов'язкові: StreamLab використає файловий резервний режим.
DATABASE_URL=''
REDIS_URL=''

# Попередження про заповнення диска.
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90
# Частота live-оновлення CPU, RAM, диска й мережі (1000–30000 мс).
SYSTEM_MONITOR_INTERVAL_MS=2000

# Якщо FFmpeg/ffprobe не додані до PATH, вкажіть абсолютні шляхи до exe-файлів
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Фонова підготовка stream-версії після завантаження
MEDIA_TRANSCODE_VIDEO_BITRATE=8M
MEDIA_TRANSCODE_PRESET=veryfast
# false видаляє оригінал лише після успішного транскодування та перевірки результату
MEDIA_KEEP_ORIGINAL_UPLOADS=false
MEDIA_COMPRESSION_PROFILE=STANDARD

# Профіль YouTube 1080p30
MVP_VIDEO_BITRATE=8M
MVP_AUDIO_BITRATE=192k
PLAYOUT_UDP_PORT=23000
STREAM_RECONNECT_BASE_MS=2000
STREAM_RECONNECT_MAX_MS=300000
STREAM_STABLE_RUN_MS=60000

# Внутрішня адреса API для Next.js. Браузер звертається лише до /api на вебсервері.
MEDIA_INTERNAL_API_URL=http://127.0.0.1:8788

# --- Продакшн (docker compose на сервері) ---
# На сервері MEDIA_INTERNAL_API_URL задається compose-конфігурацією автоматично.

