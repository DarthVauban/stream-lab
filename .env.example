# Локальний API медіасервера
MEDIA_API_HOST=127.0.0.1
MEDIA_API_PORT=8788
MEDIA_DATA_DIR=./data
MEDIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Якщо FFmpeg не доданий до PATH, вкажіть абсолютний шлях до ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Профіль YouTube 1080p30
MVP_VIDEO_BITRATE=10M
MVP_AUDIO_BITRATE=128k

# URL, який використовує браузерна частина
NEXT_PUBLIC_MEDIA_API_URL=http://127.0.0.1:8788

# --- Продакшн (docker compose на сервері) ---
# Підставте публічну IP-адресу сервера замість 127.0.0.1 в обох змінних нижче,
# інакше браузер ззовні не достукається до медіасервера.
# NEXT_PUBLIC_MEDIA_API_URL=http://<SERVER_IP>:8788
# MEDIA_ALLOWED_ORIGINS=http://<SERVER_IP>:3000

