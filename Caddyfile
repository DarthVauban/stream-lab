{$STREAMLAB_DOMAIN:stream.mt-panel.sbs} {
  encode zstd gzip

  @realtime path /api/events
  reverse_proxy @realtime media-server:8788

  reverse_proxy web:3000 {
    health_uri /api/health
    health_interval 10s
    health_timeout 5s
    lb_try_duration 5s
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  log {
    output stdout
    format console
  }
}
